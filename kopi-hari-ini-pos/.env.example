APP_NAME="Kopi Hari Ini POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Timezone server (WIB)
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────
# Ganti nilai di bawah dengan kredensial database Anda.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kopihariini_pos
DB_USERNAME=kopihariini
DB_PASSWORD=kopi_secret

# ─── Cache & Queue ──────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ─── Sanctum (Auth) ─────────────────────────────────────────────────────────
# Domain frontend yang diperbolehkan mengakses API (pisah koma jika lebih dari satu)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:5173

# Di produksi, aktifkan cookie aman:
# SESSION_SECURE_COOKIE=true

# ─── Mail (opsional, untuk notifikasi) ───────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="pos@kopihariini.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Vite / Frontend ─────────────────────────────────────────────────────────
# URL API untuk frontend (digunakan saat build produksi)
VITE_API_URL=http://localhost:8000

# ─── Produksi (hapus komentar saat deploy) ───────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://kopihariini.com
# DB_HOST=127.0.0.1
# DB_DATABASE=kopihariini_pos
# DB_USERNAME=<production_user>
# DB_PASSWORD=<production_password>
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=kopihariini.com
# CACHE_STORE=file
# QUEUE_CONNECTION=database
